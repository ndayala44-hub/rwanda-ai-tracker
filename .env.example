# ---------------------------------------------------------------------------
# Rwanda AI Tracker — configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- API service -----------------------------------------------------------
PORT=4010
HOST=0.0.0.0
NODE_ENV=development

# Absolute or relative path to the versioned dataset directory.
DATA_DIR=./data

# Comma-separated list of origins allowed to call the API.
# Use an explicit list in production; "*" is development only.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Seconds the bootstrap payload may be cached by clients.
CACHE_TTL_SECONDS=300

# --- Write access ----------------------------------------------------------
# Bearer token required for any write endpoint (observation edits, dataset
# loads, verification changes). Generate with: openssl rand -hex 32
# Leave unset to run the API strictly read-only, which is the safe default.
ADMIN_API_TOKEN=

# --- Frontend --------------------------------------------------------------
# The web app resolves its data layer in this order:
#   1. ?api=<url> query parameter, or window.TRACKER_API_BASE
#   2. ./data/bootstrap.json
#   3. the dataset embedded in index.html
TRACKER_API_BASE=http://localhost:4010

# --- Optional ingestion sources -------------------------------------------
# The World Bank indicator API requires no key. Sources that do require one
# (for example a licensed company database) belong here, never in source code.
WORLDBANK_BASE=https://api.worldbank.org/v2
# CRUNCHBASE_API_KEY=
